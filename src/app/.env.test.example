# Copy to .env.test (gitignored) to run the Modal command parser tests against
# real credential strings instead of placeholders.
#
# Nothing here is required: every test passes without this file. The parser
# tests care only about the SHAPE of the string, never whether it authenticates,
# so placeholders exercise exactly the same code paths.
#
# Do not commit real values. .env.test is ignored; this .example file is not.
MODAL_TEST_TOKEN_ID=ak-EXAMPLETOKENID
MODAL_TEST_TOKEN_SECRET=as-EXAMPLETOKENSECRET
